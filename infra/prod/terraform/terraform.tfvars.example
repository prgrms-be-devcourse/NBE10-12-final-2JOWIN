# 복사해서 terraform.tfvars 로 쓴다. terraform.tfvars 는 커밋되지 않는다.
#
# 전부 variables.tf 에 기본값이 있다. 기본값 그대로 쓸 거면 이 파일이 필요 없다.
#
# init 은 버킷 이름을 따로 넣어야 한다 (계정 ID 가 들어가서 코드에 못 박는다):
#   terraform init -backend-config="bucket=2jo-tfstate-<계정ID>"

# 100% 도달 시 정지할 인스턴스. compute 모듈 apply 후에 채운다.
# stop_instance_ids = ["i-0abc123def456"]

# 계정이 Organizations 멤버라 Budget Action 생성이 거부되면 false 로 내린다.
# enable_budget_actions = false

# 콘솔에서 직접 리소스를 만드는 경로까지 막으려면 IAM 사용자명을 넣는다.
# developer_user_names = ["jomin4"]

# ── SSH ──────────────────────────────────────────────────────────────────
# CI 는 이 파일을 쓰지 않는다(*.tfvars 는 gitignore). GitHub Actions
# variable 로 넣으면 워크플로가 TF_VAR_ 로 넘긴다:
#   SSH_KEY_NAME       사람 접속용 AWS 키페어 이름
#   DEPLOY_PUBLIC_KEY  배포용 SSH 공개키 (공개키라 secret 이 아니다)
#
# 로컬에서 plan 을 돌려볼 때만 아래를 쓴다.
key_name          = "2jo-admin"
deploy_public_key = "ssh-ed25519 AAAA... 2jo-deploy"
