# 서버 /opt/2jo/.env 에 들어갈 키 목록.
#
# 이 파일이 필요한 키의 유일한 출처다. 세 곳이 이걸 본다.
#
#   1. 사람    — PROD_ENV_FILE 시크릿을 만들 때 여기서 복사해 값을 채운다
#   2. CI      — config-check 가 이 파일로 더미 env 를 만들어 compose 를 검증한다
#   3. CI      — check-env-keys.py 가 앱·compose 가 실제로 요구하는 키를
#                이 파일이 다 담고 있는지 대조한다
#
# 3 이 없으면 이 파일이 조용히 낡는다. 실제로 그런 일이 있었다 —
# 더미 env 에 DB_URL 과 INVITATION_BASE_URL 이 빠져 있었는데, config-check 는
# compose 파싱만 보므로 통과했다. CI 는 초록불인데 서버에서 앱이 못 뜨는
# 조합이었다(Spring 은 기본값 없는 placeholder 를 못 채우면 기동에 실패한다).
#
# 여기 있는 값은 전부 가짜다. 실제 값은 GitHub Secrets 의 PROD_ENV_FILE 에만 둔다.
#
# BACKEND_IMAGE 는 여기 없다 — deploy.sh 가 .env.image 에 따로 쓴다.
# 여기 넣으면 배포마다 덮어쓰기가 충돌한다.

# ── 서버 인프라 (compose · Caddy · Grafana) ──────────────────────────────
# Caddy 가 api.{$DOMAIN} 으로 조립한다
DOMAIN=example.com
# Let's Encrypt 인증서 만료 알림을 받을 주소
ACME_EMAIL=ops@example.com
# Grafana 관리자. 공개망에 노출되지 않지만 터널로 들어오면 이 값이 전부다
GRAFANA_ADMIN_PASSWORD=dummy
# Grafana 알람이 나가는 곳
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0/x

# ── DB ───────────────────────────────────────────────────────────────────
# postgres 컨테이너와 Spring 이 같은 값을 봐야 한다. 어긋나면 앱이 붙지 못한다.
DB_USERNAME=twojo
DB_PASSWORD=dummy
# compose 에는 기본값(twojo)이 있지만 DB_URL 과 맞춰야 하므로 명시한다
DB_NAME=twojo
# 호스트가 localhost 가 아니라 postgres 다 — 같은 도커 네트워크의 서비스 이름
DB_URL=jdbc:postgresql://postgres:5432/twojo

# ── 앱 (Spring prod 프로파일) ────────────────────────────────────────────
# 기본값 없음. 빠뜨리면 조용히 약한 키로 도는 대신 기동이 실패한다
JWT_SECRET=dummy
# 와일드카드 금지. 정확한 오리진만 적는다
CORS_ALLOWED_ORIGINS=https://app.example.com
# 메일에 실릴 링크의 앞부분. 빠뜨리면 엉뚱한 링크가 조용히 나간다
PASSWORD_RESET_BASE_URL=https://app.example.com/password-reset
INVITATION_BASE_URL=https://app.example.com/invitations
VIEW_LINK_BASE_URL=https://app.example.com
