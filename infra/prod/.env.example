# 서버 /opt/2jo/.env 에 들어갈 키 목록.
#
# 이 파일이 필요한 키의 유일한 출처다. 세 곳이 이걸 본다.
#
#   1. 사람    — PROD_ENV_FILE 시크릿을 만들 때 여기서 복사해 값을 채운다
#   2. CI      — config-check 가 이 파일로 더미 env 를 만들어 compose 를 검증한다
#   3. CI      — check-env-keys.py 가 앱·compose 가 실제로 요구하는 키를
#                이 파일이 다 담고 있는지 대조한다
#
# 3 이 없으면 이 파일이 조용히 낡는다. 실제로 그런 일이 있었다 —
# 더미 env 에 DB_URL 과 INVITATION_BASE_URL 이 빠져 있었는데, config-check 는
# compose 파싱만 보므로 통과했다. CI 는 초록불인데 서버에서 앱이 못 뜨는
# 조합이었다(Spring 은 기본값 없는 placeholder 를 못 채우면 기동에 실패한다).
#
# 여기 있는 값은 전부 가짜다. 실제 값은 GitHub Secrets 의 PROD_ENV_FILE 에만 둔다.
#
# BACKEND_IMAGE 는 여기 없다 — deploy.sh 가 .env.image 에 따로 쓴다.
# 여기 넣으면 배포마다 덮어쓰기가 충돌한다.

# ── 서버 인프라 (compose · Caddy · Grafana) ──────────────────────────────
# Caddy 가 api.{$DOMAIN} 으로 조립한다
DOMAIN=example.com
# Let's Encrypt 인증서 만료 알림을 받을 주소
ACME_EMAIL=ops@example.com
# Grafana 관리자. 공개망에 노출되지 않지만 터널로 들어오면 이 값이 전부다
GRAFANA_ADMIN_PASSWORD=dummy
# Grafana 알람이 나가는 곳
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0/x

# ── DB ───────────────────────────────────────────────────────────────────
# postgres 컨테이너와 Spring 이 같은 값을 봐야 한다. 어긋나면 앱이 붙지 못한다.
DB_USERNAME=twojo
DB_PASSWORD=dummy
# compose 에는 기본값(twojo)이 있지만 DB_URL 과 맞춰야 하므로 명시한다
DB_NAME=twojo
# 호스트가 localhost 가 아니라 postgres 다 — 같은 도커 네트워크의 서비스 이름
DB_URL=jdbc:postgresql://postgres:5432/twojo

# ── 앱 (Spring prod 프로파일) ────────────────────────────────────────────
# 기본값 없음. 빠뜨리면 조용히 약한 키로 도는 대신 기동이 실패한다
JWT_SECRET=dummy
# 와일드카드 금지. 정확한 오리진만 적는다
CORS_ALLOWED_ORIGINS=https://app.example.com
# 메일에 실릴 링크의 앞부분. 빠뜨리면 엉뚱한 링크가 조용히 나간다.
#
# 뒤에 무엇이 붙는지가 키마다 다르고, 프론트 라우트와 정확히 맞아야 한다.
#   PASSWORD_RESET_BASE_URL  + "?token=" + 토큰   -> /password-reset
#   INVITATION_BASE_URL      + "/"      + 토큰   -> /invite/:token
#   VIEW_LINK_BASE_URL       + "/q/"    + 토큰   -> /q/:token
#
# INVITATION_BASE_URL 예시가 /invitations 였다. 프론트에 그런 라우트가 없어
# 초대 메일 링크가 404 로 열린다 — 메일은 정상 발송되므로 받은 사람이
# 누르기 전까지 아무도 모른다 (#368).
PASSWORD_RESET_BASE_URL=https://app.example.com/password-reset
INVITATION_BASE_URL=https://app.example.com/invite
VIEW_LINK_BASE_URL=https://app.example.com

# ── 메일 발송 (Resend SMTP) ──────────────────────────────────────────────
# 공급자가 SES 에서 Resend 로 바뀌었다. 계정이 iam:CreateUser 와
# iam:CreateAccessKey 를 거부해 SES SMTP 자격증명을 만들 수 없었다 (#320).
# 어댑터는 공급자 중립이라 코드는 그대로고 이 네 값만 갈아끼웠다.
#
# 여섯 개 중 check-env-keys 가 잡는 것은 MAIL_FROM 뿐이다. 나머지는
# application.yml 에 기본값이 있어 빠뜨려도 CI 가 조용한데, 그 상태로 배포하면
# 앱은 정상으로 뜨고 메일만 전부 FAILED 로 닫힌다. 그래서 여섯 개를 다 적어 둔다.

# 이 값이 smtp 일 때만 실제로 발송한다. 없거나 log 면 로그만 찍는다(기본).
# 정확히 smtp 여야 한다 — ses 처럼 다른 값을 넣으면 EmailSender 빈이 둘 다
# 조건에 안 걸려 사라지고, 메일이 아니라 앱 자체가 뜨지 않는다.
TWOJO_MAIL_SENDER=log
# 인증된 도메인의 주소. 수신은 하지 않으므로 답장은 아무 데도 안 간다
MAIL_FROM=no-reply@example.com
MAIL_SMTP_HOST=smtp.resend.com
# 587 = STARTTLS. 465 를 넣으면 안 된다 — application.yml 이 starttls.required
# 로 잡혀 있어 암시적 TLS 포트와는 핸드셰이크가 어긋난다.
MAIL_SMTP_PORT=587
# 이메일 주소가 아니라 resend 라는 고정 문자열이다. 비밀번호 자리에 API 키가 온다.
MAIL_SMTP_USERNAME=resend
MAIL_SMTP_PASSWORD=dummy
