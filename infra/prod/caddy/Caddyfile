# TLS 종단 + 백엔드 리버스 프록시.
#
# Caddy 를 고른 이유는 인증서 자동 발급·갱신이다.
# nginx + certbot 조합은 갱신 크론과 재기동을 직접 관리해야 한다.
#
# 설계 근거: containers.md §4

{
	# Let's Encrypt 만료 알림을 받을 주소. .env 에서 온다.
	email {$ACME_EMAIL}

	# 엣지 지표를 켠다. 이게 따로 필요한 이유: 앱이 죽으면 backend 의
	# http_server_requests 자체가 안 나온다. "요청이 0"으로 보여 장애를
	# 놓치는데, Caddy 는 그때도 502 를 센다.
	#
	# servers { metrics } 는 폐기 예정이라 전역 옵션을 쓴다 (Caddy 2.11 경고).
	metrics
}

# 지표 전용 리스너 (#222).
#
# 이 줄을 켜는 것만으로는 지표가 밖으로 나오지 않는다. 수집은 위의
# metrics 가 켜고, 내보내는 것은 이 핸들러다. 둘 다 있어야 한다.
#
# 원래는 관리 API(:2019)로 나오는데, 그 포트의 기본 바인딩이
# localhost 라 Prometheus 컨테이너에서 닿지 않았다 — 배포 첫날부터
# caddy 타깃이 죽어 있었다.
#
# admin :2019 로 관리 API 를 여는 방법도 있지만 택하지 않았다. 관리
# API 는 설정 교체까지 되므로, 컨테이너 하나가 뚫리면 Caddy 를 통째로
# 갈아치울 통로가 된다. 이 리스너는 읽기만 내보낸다.
#
# 호스트 포트로 게시하지 않는다. compose 에서 포트를 열지 않으므로
# 도커 네트워크 안에서만 닿는다.
:2020 {
	metrics /metrics
}

api.{$DOMAIN} {
	# actuator 는 공개망에 열지 않는다 (docs/14 §2-11).
	# Prometheus 는 도커 네트워크 안에서 backend:8080 을 직접 스크레이프하므로
	# 여기서 막아도 모니터링에 지장이 없다.
	handle /actuator/* {
		respond 404
	}

	reverse_proxy backend:8080 {
		# 배포로 컨테이너가 재기동되는 30초 동안 502 를 던지는 대신
		# 요청을 붙들고 재시도한다. 사용자에게는 "느린 요청"으로 보인다.
		lb_try_duration 45s
		lb_try_interval 500ms
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 서버 종류를 굳이 알려줄 이유가 없다
		-Server
	}

	log {
		output stdout
		# Promtail 이 파싱할 수 있게 JSON 으로 남긴다
		format json
	}
}
