# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/

# 환경변수 — 시크릿은 저장소에 두지 않는다 (docs/14 §2-8)
.env
.env.local
.env.*.local

# Terraform — 상태 파일에는 리소스 속성이 평문으로 들어간다. 절대 커밋 금지.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info

# 실제 값이 담긴 변수 파일 — 예제만 커밋한다
*.tfvars
*.tfvars.json
!*.tfvars.example

# plan 결과에도 전체 구성이 들어간다
*.tfplan
plan.json
crash.log
crash.*.log

# Lambda 배포 패키지 (빌드 산출물)
infra/**/*.zip

# .terraform.lock.hcl 은 의도적으로 커밋한다 — 프로바이더 버전을 팀이 공유해야 한다
# 단, 자식 모듈 것은 제외한다. 락 파일은 루트 모듈(스택)만 갖는다 —
# 모듈 디렉터리에서 init 을 돌리면 생기는데, 커밋하면 루트 것과 어긋난다
infra/prod/terraform/modules/*/.terraform.lock.hcl

# Python 빌드 산출물 — 인프라 스크립트(cost_report.py · Lambda 소스)
__pycache__/
*.py[cod]
